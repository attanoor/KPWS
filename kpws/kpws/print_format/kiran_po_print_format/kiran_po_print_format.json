 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n  <style>\r\n    body {\r\n      font-family: Arial, sans-serif;\r\n      margin: 0;\r\n      padding: 18px;\r\n    }\r\n\r\n    .center-logo {\r\n      text-align: center;\r\n      margin-bottom: 10px;\r\n    }\r\n\r\n    .center-logo h1 {\r\n      font-size: 26px;\r\n      font-weight: bold;\r\n      margin: 0;\r\n    }\r\n\r\n    h2 {\r\n      text-align: center;\r\n      text-decoration: underline;\r\n      margin: 10px 0 30px 0;\r\n      font-size: 24px;\r\n    }\r\n\r\n    .custom-table {\r\n      width: 100%;\r\n      border-collapse: collapse;\r\n      margin-bottom: 20px;\r\n    }\r\n\r\n    .custom-table th, .custom-table td {\r\n      border-bottom: 1px solid #000;\r\n      padding: 8px;\r\n      text-align: left;\r\n    }\r\n\r\n    .custom-table th {\r\n      background-color: #f2f2f2;\r\n    }\r\n\r\n    .terms-totals {\r\n      display: flex;\r\n      justify-content: space-between;\r\n      margin-top: 30px;\r\n    }\r\n\r\n    .terms-box, .totals-box {\r\n      width: 48%;\r\n    }\r\n        .terms-conditions {\r\n      width: 100%;\r\n    }\r\n\r\n    .terms-box p {\r\n      margin: 0;\r\n      font-size: 14px;\r\n    }\r\n\r\n    .totals-box p {\r\n      font-size: 14px;\r\n      margin: 6px 0;\r\n    }\r\n\r\n    .signature-section {\r\n      display: flex;\r\n      justify-content: space-between;\r\n      margin-top: 50px;\r\n    }\r\n\r\n    .signature-box {\r\n      width: 45%;\r\n      text-align: center;\r\n      padding: 20px;\r\n      border-top: 1px solid #000;\r\n    }\r\n\r\n    .footer {\r\n      margin-top: 50px;\r\n      text-align: center;\r\n      font-size: 12px;\r\n      color: #555;\r\n    }\r\n\r\n  </style>\r\n</head>\r\n<body>\r\n\r\n<div class=\"center-logo\">\r\n  <img src=\"/files/main_logo-removebg-preview.png\" alt=\"KPWS Logo\" style=\"height: 80px; margin-bottom: 10px;\">\r\n  <h1>Kiran Patient Welfare Society (KPWS)</h1>\r\n</div>\r\n\r\n  <h2>Purchase Order</h2>\r\n\r\n  <!-- Supplier and Order Info -->\r\n  <table class=\"custom-table\">\r\n    <tr>\r\n      <th>Supplier</th>\r\n      <th>Order Details</th>\r\n    </tr>\r\n    <tr>\r\n      <td>\r\n        <strong>Name:</strong> {{ doc.supplier }}\r\n      </td>\r\n      <td>\r\n        <strong>PO No:</strong> {{ doc.name }}<br>\r\n        <strong>Date:</strong> {{ doc.transaction_date }}<br>\r\n        <strong>Delivery Date:</strong> {{ doc.schedule_date or '' }}\r\n      </td>\r\n    </tr>\r\n  </table>\r\n\r\n  <!-- Item Table -->\r\n  <table class=\"custom-table\">\r\n    <tr>\r\n      <th>Sr</th>\r\n      <th>Item Name</th>\r\n      <th>Qty</th>\r\n      <th>UOM</th>\r\n      <th>Rate</th>\r\n      <th>Amount</th>\r\n    </tr>\r\n    {% for item in doc.items %}\r\n    <tr>\r\n      <td>{{ item.idx }}</td>\r\n      <td>{{ item.item_name }}</td>\r\n      <td>{{ item.qty }}</td>\r\n      <td>{{ item.uom }}</td>\r\n<td>{{ \"{:,.2f}\".format(item.rate) }}</td>\r\n<td>{{ \"{:,.2f}\".format(item.amount) }}</td>\r\n    </tr>\r\n    {% endfor %}\r\n  </table>\r\n\r\n  <!-- Totals & Terms -->\r\n  <div class=\"terms-totals\">\r\n    <div class=\"totals-box\">\r\n<p><strong>Total Amount:</strong> PKR {{ \"{:,.2f}\".format(doc.total) }}</p>\r\n<p><strong>Taxes/Other Charges:</strong> PKR {{ \"{:,.2f}\".format(doc.taxes_and_charges or 0) }}</p>\r\n<p><strong>Grand Total:</strong> PKR {{ \"{:,.2f}\".format(doc.rounded_total) }}</p>\r\n      <p><strong>Amount in Words:</strong><br> {{ doc.in_words }}</p>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Approval Signatures -->\r\n  <div class=\"signature-section\">\r\n              <div class=\"signature-box\">\r\n      _______________________<br>\r\n      <b>Muhammad Naveed</b><br>\r\n      <b>Asst Manager Supply Chain</b>\r\n    </div>\r\n    <div class=\"signature-box\">\r\n      _______________________<br>\r\n      <b>Ahsan Qadir Munshi</b><br>\r\n      <b>Administrator</b>\r\n    </div>\r\n    <div class=\"signature-box\">\r\n      _______________________<br>\r\n      <b>Dr. Asghar H Asghar.</b><br>\r\n      <b>Director (Kiran Hospital)</b>\r\n    </div>\r\n  </div>\r\n    <div class=\"terms-totals\">\r\n    <div class=\"terms-conditions\">\r\n      <strong>Terms & Conditions:</strong>\r\n      <p>\r\n1- Please mention the Batch No & Expiry date of Medicine on Invoice/ Delivery Challan.<br>\r\n\r\n2- Part Delivery part payment not allowed - Payment will be made only when complete order is supplied.<br>\r\n\r\n3- Mandatory for suppliers to inform in writing on their letter head within two days of receipt of P.O stating reason for delay in supply.<br>\r\n\r\n4- Any item not supplied on time and nothing received in writing, in this case we will purchase from open market & difference will be recovered from supplier.<br>\r\n\r\n5- Delivery to be made before 13:30 Monday - Saturday on Friday before 11:30.<br>\r\n\r\n6- Must be bound to Replace the short Expiry Medicine.</p>\r\n    </div>\r\n    </div>\r\n</body>\r\n</html>",
